# Secrets — never commit real values
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Node / Next.js
node_modules/
.next/
out/
build/
*.tsbuildinfo
.npm/
.pnpm-store/

# ML artifacts and data (keep the repo small; artifacts are versioned by pointer)
ml/models/*.joblib
ml/models/*.pkl
ml/models/*.json.tmp
ml/datasets/processed/
ml/datasets/raw/
!ml/datasets/.gitkeep
!ml/models/.gitkeep

# Notebooks checkpoints
.ipynb_checkpoints/

# Editors and OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db

# Docker volumes and local DB
docker/data/
*.sqlite3

# Test / coverage reports
/coverage
playwright-report/
test-results/

# Vercel / build outputs
.vercel
