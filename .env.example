# DevPulse — environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Database -------------------------------------------------------------
# Local Docker Compose Postgres. In production this is the Supabase pooler URL.
DATABASE_URL=postgresql+psycopg://devpulse:devpulse@localhost:5432/devpulse

# Test database (created by the test suite / docker-compose.test.yml)
TEST_DATABASE_URL=postgresql+psycopg://devpulse:devpulse@localhost:5432/devpulse_test

# --- GitHub ---------------------------------------------------------------
# Read-only, public-repo scope only (classic PAT with only `public_repo`, or a
# fine-grained token with Contents+PullRequests+Issues read on public repos).
GITHUB_TOKEN=

# Base URLs. Override only for tests or GitHub Enterprise (non-goal for v1).
GITHUB_API_URL=https://api.github.com
GITHUB_GRAPHQL_URL=https://api.github.com/graphql

# --- Ingestion ------------------------------------------------------------
# History depth per ADR-006 (months). Very large repos are auto-reduced to 12.
INGESTION_HISTORY_MONTHS=24
# Page size for GitHub API requests (max 100).
INGESTION_PAGE_SIZE=100
# Pause a running job when fewer rate-limit points than this remain.
INGESTION_MIN_RATE_BUDGET=200
# Max file_change rows stored per PR before truncation (ADR-006).
INGESTION_MAX_FILE_CHANGES_PER_PR=1000
# Per-request timeout in seconds.
INGESTION_REQUEST_TIMEOUT=30

# --- App ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Comma-separated allow-list of repositories that may be ingested in v1.
# Example: fastapi/fastapi,pallets/flask
ALLOWED_REPOS=

# CORS: the deployed frontend origin(s), comma-separated.
FRONTEND_ORIGIN=http://localhost:3000

# Environment: local | staging | production
ENVIRONMENT=local

# --- Deferred until OAuth is added (v2) -----------------------------------
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_REDIRECT_URL=
